NODE_ENV=development
PORT=8893
INCIDENT_PORT=8893
INCIDENT_DATABASE_URL="postgresql://incident_user:incident_password@localhost:5433/incident_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY_ID=minio_admin
MINIO_SECRET_ACCESS_KEY=minio_admin_secret
MINIO_BUCKET_EVIDENCES=ppe-evidences
MINIO_FORCE_PATH_STYLE=true

# Security & Gateway
GATEWAY_INTERNAL_SECRET=smart_ppe_gateway_secret_key_change_me
TRUST_PROXY=1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Auth Verification
AUTH_JWKS_URL=http://localhost:9999/.well-known/jwks.json
